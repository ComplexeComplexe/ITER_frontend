<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630" width="1200" height="630">
  <!-- Gradient background -->
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1E40AF;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#7C3AED;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="cardGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#FFFFFF;stop-opacity:0.95" />
      <stop offset="100%" style="stop-color:#F8F9FA;stop-opacity:0.95" />
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="1200" height="630" fill="url(#bgGrad)"/>

  <!-- Left side: Icon/Illustration -->
  <g transform="translate(100, 150)">
    <!-- Briefcase icon -->
    <rect x="0" y="30" width="200" height="150" rx="12" fill="#FFFFFF" opacity="0.15"/>
    <rect x="30" y="60" width="140" height="100" rx="8" fill="none" stroke="#FFFFFF" stroke-width="4"/>
    <rect x="50" y="45" width="100" height="20" rx="4" fill="none" stroke="#FFFFFF" stroke-width="3"/>
    <line x1="80" y1="160" x2="120" y2="160" stroke="#FFFFFF" stroke-width="2"/>
  </g>

  <!-- Right side: Text content -->
  <g transform="translate(450, 100)">
    <!-- Main title -->
    <text x="0" y="0" font-size="56" font-weight="700" fill="#FFFFFF" font-family="'Helvetica Neue', Arial, sans-serif" letter-spacing="-1">
      DAF Externalisé
    </text>

    <!-- Subtitle -->
    <text x="0" y="80" font-size="32" font-weight="400" fill="#FFFFFF" font-family="'Helvetica Neue', Arial, sans-serif" opacity="0.9">
      Direction Financière Flexible
    </text>

    <!-- Description -->
    <text x="0" y="140" font-size="20" font-weight="400" fill="#FFFFFF" font-family="'Helvetica Neue', Arial, sans-serif" opacity="0.85">
      CFO à temps partagé • Comptabilité • Trésorerie • Stratégie
    </text>

    <!-- Stats row -->
    <g transform="translate(0, 200)">
      <g>
        <text x="0" y="0" font-size="28" font-weight="700" fill="#FFF" font-family="'Helvetica Neue', Arial, sans-serif">50 000€</text>
        <text x="0" y="28" font-size="14" font-weight="400" fill="#FFFFFF" opacity="0.8" font-family="'Helvetica Neue', Arial, sans-serif">Économies/an</text>
      </g>
      <g transform="translate(150, 0)">
        <text x="0" y="0" font-size="28" font-weight="700" fill="#FFF" font-family="'Helvetica Neue', Arial, sans-serif">30 ans</text>
        <text x="0" y="28" font-size="14" font-weight="400" fill="#FFFFFF" opacity="0.8" font-family="'Helvetica Neue', Arial, sans-serif">D'expertise</text>
      </g>
      <g transform="translate(300, 0)">
        <text x="0" y="0" font-size="28" font-weight="700" fill="#FFF" font-family="'Helvetica Neue', Arial, sans-serif">85+</text>
        <text x="0" y="28" font-size="14" font-weight="400" fill="#FFFFFF" opacity="0.8" font-family="'Helvetica Neue', Arial, sans-serif">Entreprises</text>
      </g>
    </g>
  </g>
</svg>