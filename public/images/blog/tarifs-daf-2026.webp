<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630" width="1200" height="630">
  <defs>
    <linearGradient id="bgGrad5" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1E40AF;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#059669;stop-opacity:1" />
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="1200" height="630" fill="url(#bgGrad5)"/>

  <!-- Left side: Pricing tiers icon -->
  <g transform="translate(100, 150)">
    <circle cx="80" cy="80" r="70" fill="#FFFFFF" opacity="0.15"/>
    <!-- Price bars -->
    <rect x="40" y="100" width="20" height="40" rx="2" fill="#FFFFFF" opacity="0.7"/>
    <rect x="70" y="80" width="20" height="60" rx="2" fill="#FFFFFF" opacity="0.85"/>
    <rect x="100" y="60" width="20" height="80" rx="2" fill="#FFFFFF" opacity="1"/>
  </g>

  <!-- Right side: Text -->
  <g transform="translate(450, 100)">
    <text x="0" y="0" font-size="56" font-weight="700" fill="#FFFFFF" font-family="'Helvetica Neue', Arial, sans-serif" letter-spacing="-1">
      Tarifs DAF 2026
    </text>

    <text x="0" y="80" font-size="32" font-weight="400" fill="#FFFFFF" font-family="'Helvetica Neue', Arial, sans-serif" opacity="0.9">
      Grille Tarifaire & Modèles de Pricing
    </text>

    <text x="0" y="140" font-size="20" font-weight="400" fill="#FFFFFF" font-family="'Helvetica Neue', Arial, sans-serif" opacity="0.85">
      Forfait mensuel • À la mission • Hybrid • Transparent
    </text>

    <!-- Stats -->
    <g transform="translate(0, 200)">
      <g>
        <text x="0" y="0" font-size="28" font-weight="700" fill="#FFF" font-family="'Helvetica Neue', Arial, sans-serif">2-8k€</text>
        <text x="0" y="28" font-size="14" font-weight="400" fill="#FFFFFF" opacity="0.8" font-family="'Helvetica Neue', Arial, sans-serif">/mois</text>
      </g>
      <g transform="translate(150, 0)">
        <text x="0" y="0" font-size="28" font-weight="700" fill="#FFF" font-family="'Helvetica Neue', Arial, sans-serif">70%</text>
        <text x="0" y="28" font-size="14" font-weight="400" fill="#FFFFFF" opacity="0.8" font-family="'Helvetica Neue', Arial, sans-serif">Moins cher</text>
      </g>
      <g transform="translate(300, 0)">
        <text x="0" y="0" font-size="28" font-weight="700" fill="#FFF" font-family="'Helvetica Neue', Arial, sans-serif">0€</text>
        <text x="0" y="28" font-size="14" font-weight="400" fill="#FFFFFF" opacity="0.8" font-family="'Helvetica Neue', Arial, sans-serif">Engagement min</text>
      </g>
    </g>
  </g>
</svg>